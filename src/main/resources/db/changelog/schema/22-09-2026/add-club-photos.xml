<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">
    <changeSet id="22-09-2026-add-club-photos" author="goatsports">
        <createTable tableName="club_photos">
            <column name="photo_id" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_club_photos"/>
            </column>
            <column name="club_id" type="UUID"><constraints nullable="false"/></column>
            <column name="image_url" type="VARCHAR(1000)"><constraints nullable="false"/></column>
            <column name="uploaded_by_user_id" type="UUID"><constraints nullable="false"/></column>
            <column name="created_at" type="DATETIME"/>
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="updated_at" type="DATETIME"/>
            <column name="updated_by" type="VARCHAR(255)"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="club_photos" baseColumnNames="club_id"
                constraintName="fk_club_photos_club" referencedTableName="clubs" referencedColumnNames="club_id"
                onDelete="CASCADE"/>
        <createIndex tableName="club_photos" indexName="idx_club_photos_club_created">
            <column name="club_id"/>
            <column name="created_at" descending="true"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
