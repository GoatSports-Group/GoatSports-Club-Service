<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">
    <!--
        Giai tan cau lac bo: giu nguyen du lieu, chi doi trang thai.
        Cot active da ton tai tu truoc; hai cot nay tra loi "ai giai tan, luc nao".
    -->
    <changeSet id="22-09-2026-add-club-disband" author="goatsports">
        <addColumn tableName="clubs">
            <column name="disbanded_at" type="DATETIME"/>
            <column name="disbanded_by" type="UUID"/>
        </addColumn>
        <createIndex tableName="clubs" indexName="idx_clubs_active">
            <column name="active"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
